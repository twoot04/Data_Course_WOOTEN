theme(
panel.background = element_rect(fill = "yellow", color = "black", size = 5),  # Bright yellow background
plot.background = element_rect(fill = "limegreen"),  # Lime green outer background
panel.grid.major = element_line(color = "red", linetype = "dashed", size = 2),  # Thick red dashed grid
panel.grid.minor = element_line(color = "blue", linetype = "dotted", size = 2),  # Thick blue dotted grid
axis.text = element_text(color = "red", size = 25, face = "bold"),  # Oversized, bright red axis text
axis.title = element_text(color = "darkblue", size = 30, face = "italic"),  # Huge italic axis titles
legend.background = element_rect(fill = "magenta", color = "black", size = 3),  # Magenta legend background
legend.text = element_text(size = 20, face = "bold", color = "white"),  # Hard-to-read white legend text
legend.key = element_rect(fill = "black")  # Black legend key background
) +
ggtitle("SUPER UGLY PLOT") +
theme(plot.title = element_text(size = 40, face = "bold", color = "orange"))  # Massive, orange title
